{
  "name": "homecue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4318 --strictPort",
    "build": "node scripts/prepare-runtime.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4318 --strictPort",
    "lint": "eslint src scripts test vite.config.js",
    "test": "node --test test/*.test.js",
    "test:model": "node scripts/evaluate-model.mjs",
    "model:download": "python3 scripts/download-model.py",
    "test:ui": "node --test test/ui.test.js",
    "test:wasm": "node scripts/verify-wasm.mjs",
    "test:server": "node scripts/verify-server.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "vite": "8.3.4",
    "eslint": "10.12.0",
    "jsdom": "30.1.2"
  }
}
